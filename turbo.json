{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "scripts/**",
        "next.config.mjs",
        "package.json",
        "tsconfig*.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/packages/protocols/dengue/**"
      ],
      "env": ["APP_ENV", "ALLOW_DRAFT_PROTOCOL", "TESTER_MODE", "FEEDBACK_URL", "WAITLIST_URL"],
      "passThroughEnv": ["NEXT_TELEMETRY_DISABLED"],
      "outputs": ["dist/**", "out/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig*.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "package.json", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "public/**",
        "scripts/**",
        "package.json",
        "vitest.config.*",
        "$TURBO_ROOT$/packages/protocols/dengue/**",
        "$TURBO_ROOT$/packages/protocols/schema/**",
        "$TURBO_ROOT$/tests/scenarios/*.json",
        "$TURBO_ROOT$/docs/clinical-review-checklist.md"
      ]
    }
  }
}
