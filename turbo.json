{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig*.json", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig*.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "package.json", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "vitest.config.*",
        "$TURBO_ROOT$/packages/protocols/dengue/**",
        "$TURBO_ROOT$/packages/protocols/schema/**",
        "$TURBO_ROOT$/tests/scenarios/*.json",
        "$TURBO_ROOT$/docs/clinical-review-checklist.md"
      ]
    }
  }
}
