{
  "name": "@bhanak/protocols",
  "version": "0.0.0",
  "private": true,
  "description": "Clinical protocol JSON files, JSON schema, loader, content hash and sign-off metadata.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dengue/*": "./dengue/*",
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "dengue",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "pnpm run build && node scripts/generate.mjs"
  },
  "dependencies": {
    "@bhanak/shared": "workspace:*",
    "@bhanak/triage-engine": "workspace:*",
    "zod": "^4.6.7"
  }
}
